<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The voice assistant lives in this add-on, so the launcher needs neither the microphone nor the network. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Jarvis"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <!-- Opened from the launcher's Jarvis card. -->
        <activity
            android:name=".JarvisActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- The Gemini API key is set from the adb shell only (tools-tv/adbtv.js gemini-key): DUMP is held by the
             shell, never by an ordinary app, so no other app can read or change it. -->
        <receiver
            android:name=".KeyReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.gathin.tvjarvis.SET_KEY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
